{
  "name": "markdown-editor",
  "version": "3.2.1",
  "description": "A professional markdown editor with syntactic tree parsing and WYSIWYG editing",
  "type": "module",
  "scripts": {
    "build:icons": "node scripts/build-icons.js",
    "build:test-app": "node scripts/build-test-app.js",
    "build": "npm run lint && node scripts/build-executable.js",
    "cleanup": "rm -rf test-results",
    "dist:linux": "node scripts/build-executable.js --linux",
    "dist:mac": "node scripts/build-executable.js --mac",
    "dist:win": "node scripts/build-executable.js --win",
    "lint:codestyle": "npm run lint:comments && npm run lint:quotes",
    "lint:comments": "node scripts/lint-comments.js",
    "lint:format": "biome format --write src test scripts",
    "lint:quotes": "eslint --fix -c backticks.config.js",
    "lint:rust": "cargo fmt",
    "lint:typing": "tsc -p jsconfig.json",
    "lint": "npm run lint:codestyle && npm run lint:format && npm run lint:rust && npm run lint:typing && npm run lint:codestyle",
    "preversion": "node scripts/sync-version.js",
    "setup": "playwright install firefox --with-deps",
    "start": "tauri dev",
    "test:cleanup": "rm -rf test-results",
    "test:integration": "node scripts/build-test-app.js && node scripts/test-integration.js",
    "test:real-input": "node scripts/build-test-app.js && node scripts/build-win-runner.js && playwright test --config playwright.real-input.config.js",
    "test:rust": "node scripts/test-rust.js",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test": "npm run lint && npm run test:unit && npm run test:rust && npm run test:integration && npm run test:cleanup",
    "version": "git add Cargo.toml Cargo.lock README.md RELEASE_LOG.md"
  },
  "keywords": [
    "markdown",
    "editor",
    "tauri",
    "wysiwyg"
  ],
  "author": "",
  "license": "CC0-1.0",
  "devDependencies": {
    "@biomejs/biome": "^1.5.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "eslint": "^10.0.3",
    "jsdom": "^28.1.0",
    "lucide-static": "^0.563.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "ajv": "^6.14.0",
    "minimatch": "^10.2.4",
    "tar": "^7.5.8",
    "yauzl": "^3.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
